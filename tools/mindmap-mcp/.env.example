# mindmap-mcp — optional configuration
#
# The ladder of extraction rungs. Set any provider key to enable that rung.
# The tool degrades to whichever is configured, in the order below.

# --- Rung 1: OpenAI ---
# MMCP_OPENAI_API_KEY=sk-...
# MMCP_OPENAI_MODEL=gpt-4o-mini
# MMCP_OPENAI_BASE_URL=https://api.openai.com/v1  # or a compatible endpoint

# --- Rung 2: Anthropic ---
# MMCP_ANTHROPIC_API_KEY=sk-ant-...
# MMCP_ANTHROPIC_MODEL=claude-opus-4-7

# --- Rung 3: Local Ollama / OpenAI-compatible ---
# MMCP_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# MMCP_LOCAL_MODEL=qwen3:8b
# MMCP_LOCAL_API_KEY=ollama       # any non-empty string; Ollama ignores it

# --- Renderer defaults ---
# MMCP_DEFAULT_THEME=mylens        # mylens | dark | monochrome | brand
# MMCP_DEFAULT_WIDTH=1920
# MMCP_DEFAULT_HEIGHT=1200

# --- Cache ---
# MMCP_CACHE_DIR=~/.cache/mindmap-mcp/
