# youtube-transcript-mcp configuration.
# Every value is OPTIONAL. With none of these set, the server runs the free
# path (cache -> youtube-transcript-api -> yt-dlp), which is all you need when
# running locally on a residential IP (phase 1 on APOLLO).

# --- Cache -----------------------------------------------------------------
# Where the SQLite transcript cache lives. Default: ~/.cache/youtube-transcript-mcp/
# YTMCP_CACHE_DIR=/Users/kenrom/ZeroPoint/data/transcripts

# --- Residential proxy (rung 1) -------------------------------------------
# Needed ONLY when running from a datacenter/cloud IP (phase 2 on a server),
# where YouTube blocks the direct timedtext path. Webshare rotating residential:
# YTMCP_WEBSHARE_USERNAME=your-webshare-username
# YTMCP_WEBSHARE_PASSWORD=your-webshare-password
# YTMCP_WEBSHARE_LOCATIONS=us,de           # optional comma-separated country filter
# ...or a generic proxy instead of Webshare:
# YTMCP_HTTP_PROXY=http://user:pass@host:port
# YTMCP_HTTPS_PROXY=https://user:pass@host:port

# --- Managed API backstop (rung 3) ----------------------------------------
# Off unless a key is set. Adapt fetchers._call_managed_provider() to your provider.
# YTMCP_MANAGED_API_KEY=your-provider-key
# YTMCP_MANAGED_PROVIDER=supadata          # 'supadata' or 'generic'
# YTMCP_MANAGED_BASE_URL=https://your-provider/endpoint   # for provider=generic

# --- Local ASR fallback (rung 4) ------------------------------------------
# Off by default. Requires: pip install "youtube-transcript-mcp[asr]" (faster-whisper).
# YTMCP_ENABLE_ASR=1
# YTMCP_ASR_MODEL=base                      # tiny|base|small|medium|large-v3
