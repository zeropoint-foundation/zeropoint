#!/bin/sh
#
# .githooks/pre-commit
#
# Run the discipline pins before every commit.
#
# # Why this exists (2026-08-09, SEAM-010)
#
# The pins were already written, already correct, and already wired into
# `.github/workflows/ci.yml` via `cargo test --workspace`. They still went
# unread for eight days, because CI triggers on push to `main` and `main` was
# 93 commits ahead of `origin/main` with no push in sight. Two pins were red
# the whole time — `no_raw_home_lookup` since 2026-08-01, and
# `granted_tools_must_be_reachable` since a refactor moved the declaration it
# parses. Both failed loudly into a log nobody ran.
#
# The posture is local-first and deliberate. Under that posture `pre-push`
# never fires either, so it cannot be the safety net. This hook is the reader
# the pins never had.
#
# # Scope: the pins, not the suite
#
# `cargo test -p zp-discipline` only. NOT `--workspace`.
#
# The pins are grep over source — sub-second on a warm build. The workspace
# suite takes minutes, and as of 2026-08-09 it did not compile at all
# (`zp-configure`'s test fixture lost a `ToolManifest` field). A pre-commit
# hook that takes minutes, or that blocks every commit on an unrelated break,
# gets disabled within a week — and a disabled hook is worse than no hook,
# because the repo still contains one and everyone assumes it runs.
#
# Heavier checks belong in `just check`, run on a cadence you choose.
#
# # --no-fail-fast is load-bearing
#
# cargo aborts remaining test *targets* after the first failure. Each pin is
# its own target, so without this flag a single red pin hides every pin behind
# it alphabetically. That happened twice on 2026-08-09: the run stopped at
# `granted_tools_must_be_reachable` and `no_raw_home_lookup` only surfaced on
# the next run. You want every violation in one pass.
#
# # What this does not check
#
# The pins read the **working tree**, not the staged snapshot. With a partial
# `git add -p`, a pin can pass here while the committed content violates it.
# Accepted deliberately: staging a pristine index per commit costs a temp
# worktree and several seconds, and the failure this hook exists to prevent —
# a red pin nobody reads for days — is not the partial-staging failure.
# `pre-push` already materialises HEAD properly for the build check.
#
# # Bypass
#
# `git commit --no-verify`. Use it when you are deliberately committing a
# known-red state, and say so in the commit message. Silent bypassing is how
# a pin becomes decoration.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found on PATH — skipping discipline pins."
    echo "pre-commit: this is a gap, not a pass. Run 'cargo test -p zp-discipline' when you can."
    exit 0
fi

echo "pre-commit: discipline pins..."

if ! cargo test -p zp-discipline --no-fail-fast --quiet; then
    echo ""
    echo "pre-commit: discipline pins failed. Commit aborted."
    echo ""
    echo "Each pin names the invariant it holds and why, in its own panic"
    echo "message and module doc. Read the message before changing the pin —"
    echo "several of these exist because a convention held only in developer"
    echo "memory turned out to be insufficient."
    echo ""
    echo "If a pin is genuinely obsolete because the thing it guards moved,"
    echo "fix its parser. Do not delete the pin. That distinction is recorded"
    echo "in docs/DELIBERATION-LOG-2026-08.md under SEAM-005."
    echo ""
    echo "To commit anyway: git commit --no-verify"
    echo ""
    exit 1
fi

echo "pre-commit: pins green."
